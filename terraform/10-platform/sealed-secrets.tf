# sealed-secrets. Controller name and namespace are pinned
# (`sealed-secrets-controller` in `sealed-secrets`): that is what kubeseal needs
# in --controller-name / --controller-namespace.
#
# The master key is generated by the controller itself (a Secret labelled
# sealedsecrets.bitnami.com/sealed-secrets-key) and rotated every 30 days
# (default keyrenewperiod). Old keys are kept so already-sealed data still
# decrypts. The backup CronJob (backup.tf) copies all of them off the box.
resource "helm_release" "sealed_secrets" {
  name       = "sealed-secrets"
  namespace  = kubernetes_namespace_v1.platform["sealed-secrets"].metadata[0].name
  repository = "https://bitnami.github.io/sealed-secrets"
  chart      = "sealed-secrets"
  version    = "2.20.0" # app 0.40.0

  atomic          = true
  cleanup_on_fail = true
  timeout         = 300

  values = [yamlencode({
    fullnameOverride = "sealed-secrets-controller"
    resources = {
      requests = { cpu = "10m", memory = "32Mi" }
      limits   = { memory = "128Mi" }
    }
  })]
}
